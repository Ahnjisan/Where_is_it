# backend 로컬 실행용 환경변수 예시
# 사용법: 이 파일을 같은 폴더에 .env 로 복사하고 값을 채운다.  cp .env.example .env
#   .env 는 Git에 올라가지 않는다. 이 예시 파일에는 실제 값을 적지 않는다.
#   Spring과 Docker Compose(compose.yaml)가 이 .env 를 함께 읽는다.
# 작성 규칙: KEY=값 을 한 줄에 하나씩 쓴다.
#   따옴표·export·줄 끝 주석을 붙이지 않고, 값에 $ 를 넣지 않는다(두 도구의 해석이 달라진다).

# MySQL 접속 URL (DB 이름 where_is_it 은 compose.yaml 과 맞춘다)
DB_URL=jdbc:mysql://localhost:3306/where_is_it
# MySQL 계정 (root 는 쓸 수 없다. Docker MySQL이 이 계정을 새로 만든다)
DB_USERNAME=
# MySQL 비밀번호
DB_PASSWORD=

# Redis 주소 (생략하면 localhost:6379. 다른 주소를 쓸 때만 주석을 풀고 쓴다)
# REDIS_HOST=localhost
# REDIS_PORT=6379
