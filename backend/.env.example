# backend 로컬 실행용 환경변수 예시
# 사용법: 이 파일을 같은 폴더에 .env 로 복사하고 값을 채운다.  cp .env.example .env
#   .env 는 Git에 올라가지 않는다. 이 예시 파일에는 실제 값을 적지 않는다.
#   Spring과 Docker Compose(compose.yaml)가 이 .env 를 함께 읽는다.
# 작성 규칙: KEY=값 을 한 줄에 하나씩, 따옴표·export·줄 끝 주석 없이 쓴다.
#   값에는 $ \ # 와 공백을 넣지 않는다. Spring(.properties 형식)과 Compose가 이 문자들을 다르게 읽어서
#   MySQL에 만들어지는 비밀번호와 Spring이 접속할 때 쓰는 비밀번호가 달라질 수 있다.

# MySQL 접속 URL (DB 이름 where_is_it 은 compose.yaml 과 같아야 한다)
DB_URL=jdbc:mysql://localhost:3306/where_is_it
# MySQL 계정. Docker MySQL이 처음 시작할 때 이 계정을 만든다. root 는 쓸 수 없다.
#   계정·비밀번호를 바꾸면 docker compose down -v 로 DB를 초기화해야 적용된다(로컬 데이터 삭제).
DB_USERNAME=
# MySQL 비밀번호
DB_PASSWORD=
